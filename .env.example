# ========================================
# CONFIGURACIÓN DEL CHATBOT EDUCATIVO
# ========================================

# API Key de Google AI Studio
# Sigue las instrucciones en SETUP_API_KEY.md para obtener tu clave
GOOGLE_API_KEY="tu-api-key-aqui"

# ========================================
# CONFIGURACIÓN DEL MODELO GEMINI
# ========================================

# Opciones de modelo:
# - models/gemini-1.5-pro-latest    (Máxima calidad, más costoso)
# - models/gemini-2.5-flash          (Rápido y económico)
GEMINI_MODEL="models/gemini-1.5-pro-latest"

# Precios para el cálculo de costo por request (USD por 1M de tokens).
# Se registran en el log fastapi_app como cost_usd en la línea [TOKEN_USAGE].
# Si se dejan sin definir, el costo reportado es 0. Ajusta a los precios vigentes
# del modelo configurado en GEMINI_MODEL.
GEMINI_INPUT_PRICE_PER_1M="0"
GEMINI_OUTPUT_PRICE_PER_1M="0"

# Modelo de embeddings de Google
# Recomendado: models/gemini-embedding-001 (3072 dimensiones)
EMBEDDING_MODEL="models/gemini-embedding-001"

# ========================================
# CONFIGURACIÓN RAG
# ========================================

# Tamaño de los fragmentos de texto (chunks)
# Valores típicos: 256-1024
CHUNK_SIZE=512

# Superposición entre fragmentos (overlap)
# Valores típicos: 10-50
CHUNK_OVERLAP=20

# Número de fragmentos a recuperar por consulta
# Valores típicos: 2-5
# ⭐ RECOMENDADO: 5 (validado en producción)
SIMILARITY_TOP_K=5

# ========================================
# CONFIGURACIÓN DE SUPABASE (API REST)
# ========================================

# URL de la API de Supabase
# Ejemplo: https://xxxxx.supabase.co
SUPABASE_URL="https://dpoznldvrcsuhzhbrbfh.supabase.co"

# Service Role Key de Supabase (clave secreta con permisos completos)
# Obtén esta clave en: Project Settings > API > service_role key
# IMPORTANTE: Esta es una clave secreta, nunca la expongas en el frontend
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxx"

# Nombre de la tabla donde se almacenan los vectores
SUPABASE_TABLE_NAME="documents"

# Nombre de la función RPC para búsqueda vectorial
# Esta función debe estar creada en Supabase y recibir: query_embedding, match_count, match_threshold, filter
SUPABASE_RPC_FUNCTION="match_ec1121_gemi_mantenimiento_mecanico_automotriz"

# Dimensiones del modelo de embeddings (debe coincidir con la columna embedding)
# gemini-embedding-001 usa 3072 dimensiones (halfvec(3072))
EMBEDDING_DIMENSIONS=3072

# Umbral de similitud para búsqueda vectorial (0.0 a 1.0)
# Valores típicos: 0.3-0.7 (más alto = más estricto)
# ⭐ RECOMENDADO: 0.5 (validado con 30k+ vectores - balance óptimo)
# NOTA: 0.8+ es demasiado estricto y puede no retornar resultados
MATCH_THRESHOLD=0.5

# Recuperación en dos fases: primero chunks con metadata.topic_id, luego sin filtro si hay pocos
# Requiere migrations/004_rpc_metadata_filter.sql + AND vector_match_apply_metadata_filter(...) en match_*
# Por defecto false: usar diversidad por documento + Cohere rerank (abajo)
TOPIC_PRIORITY_RETRIEVAL=false
TOPIC_PRIORITY_MIN_RESULTS=3
# Con rerank/diversidad: fusionar búsqueda has_topic_id + global (recomendado)
RETRIEVAL_MERGE_WITH_TOPIC_ID=true

# ========================================
# RECUPERACIÓN AVANZADA (diversidad + rerank)
# ========================================
# Cuántos chunks vectoriales pedir antes de diversidad/rerank (solo si rerank o diversidad activos)
VECTOR_RETRIEVAL_K=40

# Máximo de chunks por documento (unique_content_id, o title, o topic_id)
# 0 = desactivado. Recomendado: 2
MAX_CHUNKS_PER_DOCUMENT=2

# Cohere rerank (requiere API key en https://dashboard.cohere.com/)
COHERE_RERANK_ENABLED=true
COHERE_API_KEY=""
COHERE_RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=4

# ========================================
# CONFIGURACIÓN DE LA API
# ========================================

# Puerto de la API FastAPI
API_PORT=8080

# Host de la API (0.0.0.0 para Docker, localhost para desarrollo local)
API_HOST="0.0.0.0"

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN (OPCIONAL)
# ========================================

# Habilitar modo de producción (true/false)
# PRODUCTION_MODE=false

# Número de workers para Uvicorn en producción
# WORKERS=4

# Dominio para CORS (separado por comas si son múltiples)
# CORS_ORIGINS="https://tu-dominio.com,https://www.tu-dominio.com"

# ========================================
# MEMORIA CONVERSACIONAL (capas A y B)
# ========================================
# Ver: project/memory/CONVERSATION_MEMORY_MODEL.md
# Solo se activan cuando el request trae user_id.

# Techo de tokens para el historial literal (capa A)
CHAT_HISTORY_MAX_TOKENS=3500

# Techo aproximado para el resumen inyectado en el prompt (capa B)
CHAT_SUMMARY_MAX_TOKENS=800

# Cada cuántos turnos (user+assistant) se regenera el resumen
CHAT_SUMMARY_REFRESH_EVERY_N_TURNS=6

# Tope duro de mensajes a considerar antes del recorte por tokens
CHAT_MAX_MESSAGES_SAFETY=40

# Ventana de antigüedad (horas) del historial literal enviado al LLM (capa A).
# Los mensajes más antiguos se conservan en BD y siguen visibles en /api/chat/history.
CHAT_HISTORY_MAX_AGE_HOURS=24

# ========================================
# AUTENTICACIÓN JWT (Widget Moodle)
# ========================================
# Clave secreta compartida con el plugin de Moodle que emite los tokens.
# Debe ser larga (>=32 chars) y mantenerse en secreto. El backend valida
# la firma HS256 con esta clave.
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# (Opcional) Emisor esperado en el claim "iss". Si se define, los tokens
# cuyo "iss" no coincida serán rechazados. Déjalo vacío para desactivar
# la validación de emisor.
# JWT_ISSUER="moodle-instance-name"
