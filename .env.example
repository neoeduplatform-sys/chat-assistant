# ========================================
# CONFIGURACIÓN DEL CHATBOT EDUCATIVO
# ========================================

# API Key de Google AI Studio
# Sigue las instrucciones en SETUP_API_KEY.md para obtener tu clave
GOOGLE_API_KEY="tu-api-key-aqui"

# ========================================
# CONFIGURACIÓN DEL MODELO GEMINI
# ========================================

# Opciones de modelo:
# - models/gemini-1.5-pro-latest    (Máxima calidad, más costoso)
# - models/gemini-2.5-flash          (Rápido y económico)
GEMINI_MODEL="models/gemini-1.5-pro-latest"

# Modelo de embeddings de Google
# Recomendado: models/text-embedding-004
EMBEDDING_MODEL="models/text-embedding-004"

# ========================================
# CONFIGURACIÓN RAG
# ========================================

# Tamaño de los fragmentos de texto (chunks)
# Valores típicos: 256-1024
CHUNK_SIZE=512

# Superposición entre fragmentos (overlap)
# Valores típicos: 10-50
CHUNK_OVERLAP=20

# Número de fragmentos a recuperar por consulta
# Valores típicos: 2-5
SIMILARITY_TOP_K=3

# ========================================
# CONFIGURACIÓN DE CHROMADB
# ========================================

# Host de ChromaDB (usar 'chromadb' en Docker, 'localhost' si ejecutas localmente)
CHROMADB_HOST="chromadb"

# Puerto de ChromaDB
CHROMADB_PORT=8000

# Nombre de la colección en ChromaDB
COLLECTION_NAME="course_content"

# ========================================
# CONFIGURACIÓN DE LA API
# ========================================

# Puerto de la API FastAPI
API_PORT=8080

# Host de la API (0.0.0.0 para Docker, localhost para desarrollo local)
API_HOST="0.0.0.0"

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# ========================================
# CONFIGURACIÓN DE PRODUCCIÓN (OPCIONAL)
# ========================================

# Habilitar modo de producción (true/false)
# PRODUCTION_MODE=false

# Número de workers para Uvicorn en producción
# WORKERS=4

# Dominio para CORS (separado por comas si son múltiples)
# CORS_ORIGINS="https://tu-dominio.com,https://www.tu-dominio.com"
